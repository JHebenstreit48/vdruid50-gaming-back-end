rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public game reviews
    match /gameReviews/{reviewId} {
      allow read: if true;
      allow write: if false; // only via Admin SDK
    }

    // Public bio and stream schedule
    match /vdruid50Info/{docId} {
      allow read: if true;
      allow write: if false; // only via Admin SDK
    }

    // (later) comments, users, etc
  }
}